# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Virtual envs (regenerate with `uv sync`) ---
.venv/
**/.venv/

# --- Secrets / local config ---
.env
**/.env
**/.env.local

