# --- Editor / OS / assistant tooling ---
.vscode/
.idea/
.DS_Store
/.claude/

# --- Local-only: synthetic-data generator + its large source audio ---
# The shipped test set is sample_data/claims/; the generator and its source
# mp3s are kept locally (customers bring their own data).
/generator/
/sample_data/*.mp3
